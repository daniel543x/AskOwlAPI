# <----- PostgreSQL Database Credentials ----->
POSTGRES_SERVER=localhost # required
POSTGRES_USER=user # required
POSTGRES_PASSWORD=password # required
POSTGRES_DB=database # required
POSTGRES_PORT=5432 # required

# <----- Master key ----->
# Fernet key (url-safe base64, 32 bytes) used to encrypt provider API keys.
# Required. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY= # required

# <----- Logging ----->
# LOG_LEVEL=INFO
# DEBUG=false

# <----- Refresh-token sessions (PLAN Phase 8) ----->
# Access tokens live ACCESS_TOKEN_EXPIRE_MINUTES (6 h); a refresh token
# renews the session for this many days (single-use rotation).
# REFRESH_TOKEN_EXPIRE_DAYS=90
# Superseded (rotated/expired/revoked) refresh-token rows are kept this
# long for reuse-detection evidence and audit, then purged.
# REFRESH_TOKEN_RETENTION_DAYS=30

# <----- Search engine (SearXNG) ----->
# SEARXNG_BASE_URL=http://localhost:8080
# SEARXNG_ENGINES=bing,brave,duckduckgo,google,qwant,startpage
# SEARXNG_CATEGORIES=general

# <----- Search-result hygiene (AR-2 / WU-3) ----->
# Drop results topically unrelated to the query before they cost a page
# fetch (default on; validated by the Phase-3 eval re-run).
# RESULT_SANITY_FILTER=true
# Fusion floor for URL selection (0 = off; only meaningful on calibrated
# fusion scores — leave off until measured on the eval harness). Results
# below the floor are dropped, but never fewer than three are kept.
# URL_SELECTION_MIN_FUSION=0.0
# Fusion score as the cross-encoder tie-breaker (MiniLM scores saturate
# around 0.999x, making its within-top-N ordering noise).
# FUSION_TIEBREAK=true
# Domain authority map for fusion scoring (JSON). Keys are registrable
# domains or dot-leading TLD suffixes; unknown hosts score 0.5.
# DOMAIN_AUTHORITY={".gov": 0.9, ".edu": 0.9, "wikipedia.org": 0.9}
# Per-request max_urls ceiling (WU-6).
# TOP_N_URLS_MAX=20

# <----- SearXNG container ----->
# Secret for the SearXNG instance managed by compose.yml.
SEARXNG_SECRET= # required when using compose

# <----- Hot-path caches (WU-10 / AR-1) ----->
# Search-result memoization (in-process, per provider config). Empty
# results are never cached, so transient upstream failures stay fresh.
# SEARCH_CACHE=true
# SEARCH_CACHE_TTL_S=3600
# SEARCH_CACHE_MAX_ENTRIES=512
# Per-URL scraped-content cache, Postgres-backed (survives restarts).
# The `cache: "bypass"` request parameter forces fresh fetches per turn.
# PAGE_CACHE=true
# PAGE_CACHE_TTL_S=86400
# Rule-based query fan-out ceiling (WU-2; request values clamp to this).
# QUERY_VARIATIONS_MAX=4
# Optional Redis backend for the shared small-state cache (rate-limit
# windows). Empty = in-process memory. Needs the redis extra
# (`uv sync --all-extras`); Redis failures degrade to memory.
# REDIS_URL=redis://localhost:6379/0

# <----- LLM bootstrap defaults ----->
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_CHAT_MODEL_NAME=qwen3.5
# Context window (tokens) for Ollama chat models that don't set num_ctx in
# their catalog default_params. Prevents silent prompt truncation on large
# prompts (e.g. research synthesis), which makes models drop tool calls.
# OLLAMA_NUM_CTX=32768
# DEFAULT_EMBEDDING_MODEL_NAME=bge-m3
# DEFAULT_EMBEDDING_MODEL_DIMS=1024

# <----- Hybrid retrieval ----->
# VECTOR_CANDIDATES_K=25

# <----- Research mode / agent loop ----->
# RESEARCH_MAX_SUBQUESTIONS=5
# AGENT_MAX_ITERATIONS=8
# AGENT_TIME_BUDGET_SECONDS=300
# AGENT_TOKEN_BUDGET=60000

# <----- API keys ----->
# Per-key fixed-window limit for X-API-Key traffic (requests/minute).
# API_KEY_RATE_LIMIT_PER_MINUTE=60

# <----- Decision layer pre-scores (Phase 7; off by default until eval'd) ----->
# PRE_SCORE_SEARCH_FILTER=false
# PRE_SCORE_CHUNK_FILTER=false
# PRE_SCORE_QUERY_CHOICE=false
# PRE_SCORE_GROUNDING_CHECK=false
# PRE_SCORE_RELEVANCE_THRESHOLD=0.5
# PRE_SCORE_CHUNK_MIN_SCORE=3

# <----- Laya decision sidecar (compose --profile laya) ----->
# LAYA_PRELOAD=1
# LAYA_API_KEY=

# <----- Outbound proxy ----->
# Optional HTTP(S) proxy for search + scraping egress. Set when the host is
# hosted by a provider that blocks direct traffic (rate limits, 403s).
# Empty = direct. LLM/embedding clients stay direct (often localhost).
# PROXY_URL=http://proxy.example:8080
